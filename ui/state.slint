// Rewritten in Rust from Micro Music Room (WPF) 1.0.3. Modified November 24, 2026.

import { TrackRow, PlaylistItem } from "types.slint";

// Everything the window shows, and everything the user can ask for. The Rust side owns the real
// state and pushes it in here; the components only read these properties and fire the callbacks.
export global AppState {
    // Library and navigation
    in property <[TrackRow]> rows;
    in property <[PlaylistItem]> playlists;
    in property <int> view-index: -1; // -1 all songs, -2 recently added, 0.. a playlist
    in property <string> breadcrumb: "YOUR LIBRARY  /  ALL SONGS";
    in property <string> view-title: "All songs";
    in property <string> view-subtitle;
    in property <int> total-tracks;
    in property <int> selected-count;
    in property <string> status;
    in property <bool> scanning;
    in property <string> version;
    in-out property <bool> about-open;
    in property <bool> notifications; // notify when the song changes
    in property <string> media-status; // is Windows' media layer connected?

    // Player
    in property <bool> has-current;
    in property <string> now-title;
    in property <string> now-artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat-mode; // 0 off, 1 all, 2 one
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <float> progress; // 0.0 to 1.0
    in property <bool> seekable; // false when the file doesn't report its length
    in property <float> volume: 0.8;

    // Navigation and library
    callback select-view(int);
    callback search-edited(string);
    callback add-folder();
    callback add-files();
    callback create-playlist(string);
    callback delete-playlist(int);
    callback rename-playlist(int, string);
    // Which playlist's name is being edited in the sidebar (-1: none).
    in-out property <int> renaming: -1;

    // Track rows (row = index in the visible list)
    callback rows-visible(int, int); // first visible row, how many fit: tags are read for these
    callback select-row(int, bool, bool); // row, ctrl held, shift held
    callback play-row(int);
    callback play-all();
    callback add-to-playlist(int, int); // row (-1 = the selection), playlist
    callback remove-from-playlist(int);

    // Player
    callback toggle-play();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback seek(float);
    callback volume-changed(float);
    callback notifications-changed(bool);
    callback test-notification();
}
