import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { TrackRow } from "types.slint";
import { IconButton, TextButton } from "widgets.slint";

// Column geometry shared by the header and every row so they line up.
global Columns {
    out property <length> margin: 24px;
    out property <length> number-w: 40px;
    out property <length> gap: 14px;
}

component SearchBox inherits Rectangle {
    height: 38px;
    border-radius: Theme.radius;
    background: Theme.walnut;
    border-width: 1px;
    border-color: input.has-focus ? Theme.copper : Theme.border;
    animate border-color { duration: 120ms; }

    Image {
        x: 12px;
        source: @image-url("icons/search.svg");
        width: 16px;
        height: 16px;
        colorize: Theme.parchment-faint;
    }

    input := TextInput {
        x: 38px;
        width: parent.width - 38px - 38px;
        height: parent.height;
        color: Theme.parchment;
        selection-background-color: Theme.copper;
        selection-foreground-color: Theme.walnut-deep;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        edited => {
            AppState.search-edited(self.text);
        }
    }

    Text {
        x: 38px;
        text: "Search title, artist or folder";
        color: Theme.parchment-faint;
        font-size: 14px;
        vertical-alignment: center;
        visible: input.text == "";
    }

    // Clear button (a "+" turned into an "x")
    if input.text != "": Rectangle {
        x: parent.width - 34px;
        width: 26px;
        height: 26px;
        y: (parent.height - self.height) / 2;
        border-radius: 13px;
        background: clear-touch.has-hover ? Theme.walnut-raised : transparent;

        Image {
            source: @image-url("icons/plus.svg");
            width: 14px;
            height: 14px;
            colorize: Theme.parchment-dim;
            transform-rotation: 45deg;
        }

        clear-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                input.text = "";
                AppState.search-edited("");
            }
        }
    }
}

component TrackLine inherits Rectangle {
    in property <int> index;
    in property <TrackRow> entry;
    in property <length> title-w;
    in property <length> artist-w;
    in property <length> folder-w;

    height: 38px;
    background: root.entry.playing ? Theme.copper.with-alpha(0.14) : (touch.has-hover ? Theme.walnut.with-alpha(0.9) : (Math.mod(root.index, 2) == 1 ? Theme.walnut.with-alpha(0.35) : transparent));

    // Copper marker on the track that is playing
    Rectangle {
        visible: root.entry.playing;
        width: 3px;
        background: Theme.copper;
    }

    // Number, or the note icon on the playing row
    Text {
        x: Columns.margin;
        width: Columns.number-w;
        visible: !root.entry.playing;
        text: root.index + 1;
        color: Theme.parchment-faint;
        font-family: Theme.mono;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: left;
    }

    Image {
        visible: root.entry.playing;
        x: Columns.margin;
        source: @image-url("icons/note.svg");
        width: 16px;
        height: 16px;
        colorize: Theme.copper-bright;
    }

    Text {
        x: Columns.margin + Columns.number-w + Columns.gap;
        width: root.title-w;
        text: root.entry.title;
        color: root.entry.playing ? Theme.copper-bright : Theme.parchment;
        font-size: 14px;
        font-weight: root.entry.playing ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: Columns.margin + Columns.number-w + Columns.gap + root.title-w + Columns.gap;
        width: root.artist-w;
        text: root.entry.artist;
        color: Theme.parchment-dim;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: Columns.margin + Columns.number-w + Columns.gap + root.title-w + Columns.gap + root.artist-w + Columns.gap;
        width: root.folder-w;
        text: root.entry.folder;
        color: Theme.parchment-faint;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        double-clicked => {
            AppState.play-row(root.index);
        }
    }
}

export component TrackTable inherits Rectangle {
    background: Theme.walnut-deep;

    // Width left for the three text columns once the fixed parts are taken out.
    property <length> text-space: root.width - 2 * Columns.margin - Columns.number-w - 3 * Columns.gap;
    property <length> title-w: root.text-space * 0.42;
    property <length> artist-w: root.text-space * 0.28;
    property <length> folder-w: root.text-space - root.title-w - root.artist-w;

    VerticalLayout {
        // Title and search
        HorizontalLayout {
            padding-left: Columns.margin;
            padding-right: Columns.margin;
            padding-top: 22px;
            padding-bottom: 16px;
            spacing: 20px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                Text {
                    text: AppState.view-title;
                    color: Theme.parchment;
                    font-family: Theme.serif;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    text: AppState.view-subtitle;
                    color: Theme.brass;
                    font-family: Theme.mono;
                    font-size: 12px;
                }
            }

            SearchBox {
                width: 300px;
                y: (parent.height - self.height) / 2;
            }
        }

        // Column headings
        Rectangle {
            height: 30px;
            background: Theme.walnut.with-alpha(0.6);

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            Text {
                x: Columns.margin;
                width: Columns.number-w;
                text: "#";
                color: Theme.brass;
                font-family: Theme.mono;
                font-size: 11px;
                vertical-alignment: center;
            }

            Text {
                x: Columns.margin + Columns.number-w + Columns.gap;
                width: root.title-w;
                text: "TITLE";
                color: Theme.brass;
                font-family: Theme.mono;
                font-size: 11px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Text {
                x: Columns.margin + Columns.number-w + Columns.gap + root.title-w + Columns.gap;
                width: root.artist-w;
                text: "ARTIST";
                color: Theme.brass;
                font-family: Theme.mono;
                font-size: 11px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }

            Text {
                x: Columns.margin + Columns.number-w + Columns.gap + root.title-w + Columns.gap + root.artist-w + Columns.gap;
                width: root.folder-w;
                text: "FOLDER";
                color: Theme.brass;
                font-family: Theme.mono;
                font-size: 11px;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }

        // Rows, or an empty state
        if AppState.rows.length > 0: ListView {
            vertical-stretch: 1;

            for track[index] in AppState.rows: ContextMenuArea {
                Menu {
                    MenuItem {
                        title: "Play";
                        activated => {
                            AppState.play-row(index);
                        }
                    }
                    Menu {
                        title: "Add to playlist";
                        enabled: AppState.playlists.length > 0;

                        for playlist[p] in AppState.playlists: MenuItem {
                            title: playlist.name;
                            enabled: p != AppState.view-index;
                            activated => {
                                AppState.add-to-playlist(index, p);
                            }
                        }
                    }
                    if AppState.view-index >= 0: MenuSeparator {}
                    if AppState.view-index >= 0: MenuItem {
                        title: "Remove from this playlist";
                        activated => {
                            AppState.remove-from-playlist(index);
                        }
                    }
                }

                TrackLine {
                    index: index;
                    entry: track;
                    title-w: root.title-w;
                    artist-w: root.artist-w;
                    folder-w: root.folder-w;
                }
            }
        }

        if AppState.rows.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Image {
                    source: @image-url("icons/note.svg");
                    width: 44px;
                    height: 44px;
                    colorize: Theme.border;
                }

                Text {
                    text: AppState.total-tracks == 0 ? "Your library is empty" : (AppState.view-index >= 0 ? "Nothing here yet" : "No tracks match your search");
                    color: Theme.parchment-dim;
                    font-family: Theme.serif;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                Text {
                    text: AppState.total-tracks == 0 ? "Add a folder of music to start listening." : (AppState.view-index >= 0 ? "Right-click a track in All tracks and choose Add to playlist." : "Try fewer words. Accents don't matter: slusam finds slušam.");
                    color: Theme.parchment-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                if AppState.total-tracks == 0: Rectangle {
                    height: 52px;

                    TextButton {
                        text: "Add folder";
                        icon: @image-url("icons/folder.svg");
                        width: 150px;
                        y: 16px;
                        enabled: !AppState.scanning;
                        clicked => {
                            AppState.add-folder();
                        }
                    }
                }
            }
        }
    }
}
