import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { TrackRow } from "types.slint";
import { TextButton } from "widgets.slint";

// Column geometry shared by the header and every row so they line up.
global Columns {
    out property <length> margin: 28px;
    out property <length> icon-w: 24px;
    out property <length> time-w: 64px;
    out property <length> gap: 16px;
}

component SearchBox inherits Rectangle {
    height: 38px;
    border-radius: Theme.radius;
    background: Theme.walnut;
    border-width: 1px;
    border-color: input.has-focus ? Theme.copper : Theme.border;
    animate border-color { duration: 120ms; }

    Image {
        x: 12px;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/search.svg");
        width: 15px;
        height: 15px;
        colorize: Theme.parchment-faint;
    }

    input := TextInput {
        x: 37px;
        y: 0px;
        width: parent.width - 37px - 36px;
        height: parent.height;
        color: Theme.parchment;
        selection-background-color: Theme.copper;
        selection-foreground-color: Theme.walnut-deep;
        font-size: 14px;
        vertical-alignment: center;
        edited => {
            AppState.search-edited(self.text);
        }
    }

    Text {
        x: 37px;
        y: 0px;
        height: parent.height;
        text: "Search songs";
        color: Theme.parchment-faint;
        font-size: 14px;
        vertical-alignment: center;
        visible: input.text == "";
    }

    // Clear button (a "+" turned into an "x")
    if input.text != "": Rectangle {
        x: parent.width - 32px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: clear-touch.has-hover ? Theme.walnut-raised : transparent;

        Image {
            source: @image-url("icons/plus.svg");
            width: 13px;
            height: 13px;
            colorize: Theme.parchment-dim;
            transform-rotation: 45deg;
        }

        clear-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                input.text = "";
                AppState.search-edited("");
            }
        }
    }
}

component TrackLine inherits Rectangle {
    in property <int> index;
    in property <TrackRow> entry;
    in property <length> title-w;
    in property <length> artist-w;
    in property <length> album-w;

    height: 42px;
    background: root.entry.selected ? Theme.walnut-raised : (touch.has-hover ? Theme.walnut.with-alpha(0.8) : transparent);
    animate background { duration: 90ms; }

    Image {
        x: Columns.margin;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/note.svg");
        width: 16px;
        height: 16px;
        colorize: root.entry.playing ? Theme.copper-bright : Theme.parchment-faint;
    }

    Text {
        x: Columns.margin + Columns.icon-w + Columns.gap;
        y: 0px;
        width: root.title-w;
        height: parent.height;
        text: root.entry.title;
        color: root.entry.playing ? Theme.copper-bright : Theme.parchment;
        font-size: 14px;
        font-weight: root.entry.playing ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: Columns.margin + Columns.icon-w + Columns.gap + root.title-w + Columns.gap;
        y: 0px;
        width: root.artist-w;
        height: parent.height;
        text: root.entry.artist;
        color: Theme.parchment-dim;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: Columns.margin + Columns.icon-w + Columns.gap + root.title-w + Columns.gap + root.artist-w + Columns.gap;
        y: 0px;
        width: root.album-w;
        height: parent.height;
        text: root.entry.album;
        color: Theme.parchment-faint;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - Columns.margin - Columns.time-w;
        y: 0px;
        width: Columns.time-w;
        height: parent.height;
        text: root.entry.duration;
        color: Theme.parchment-faint;
        font-family: Theme.mono;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                AppState.select-row(root.index, event.modifiers.control, event.modifiers.shift);
            }
        }
        double-clicked => {
            AppState.play-row(root.index);
        }
    }
}

component HeaderText inherits Text {
    color: Theme.brass;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    vertical-alignment: center;
}

export component TrackTable inherits Rectangle {
    background: Theme.walnut-deep;

    // Width left for the three text columns once the fixed parts are taken out.
    property <length> text-space: root.width - 2 * Columns.margin - Columns.icon-w - Columns.time-w - 4 * Columns.gap;
    property <length> title-w: root.text-space * 0.42;
    property <length> artist-w: root.text-space * 0.26;
    property <length> album-w: root.text-space - root.title-w - root.artist-w;

    VerticalLayout {
        // Breadcrumb, search and the two add buttons
        Rectangle {
            height: 76px;

            HorizontalLayout {
                padding-left: Columns.margin;
                padding-right: Columns.margin;
                spacing: 12px;

                Text {
                    text: AppState.breadcrumb;
                    color: Theme.parchment-faint;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                SearchBox {
                    width: 240px;
                    y: (parent.height - self.height) / 2;
                }

                TextButton {
                    text: AppState.scanning ? "Scanning…" : "Add folder";
                    enabled: !AppState.scanning;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.add-folder();
                    }
                }

                TextButton {
                    text: "Add songs";
                    icon: @image-url("icons/plus.svg");
                    primary: true;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.add-files();
                    }
                }
            }
        }

        // Title, count, and the two list actions
        Rectangle {
            height: 78px;

            HorizontalLayout {
                padding-left: Columns.margin;
                padding-right: Columns.margin;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: AppState.view-title;
                        color: Theme.parchment;
                        font-size: 30px;
                        font-weight: 700;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;

                        Text {
                            text: AppState.view-subtitle;
                            color: Theme.parchment-dim;
                            font-size: 13px;
                        }

                        if AppState.status != "": Text {
                            text: AppState.status;
                            color: Theme.olive;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                }

                // "Add to playlist" opens a menu of playlists for the selected songs.
                Rectangle {
                    width: 160px;
                    height: 38px;
                    y: (parent.height - self.height) / 2;

                    add-menu := ContextMenuArea {
                        Menu {
                            for playlist[p] in AppState.playlists: MenuItem {
                                title: playlist.name;
                                activated => {
                                    AppState.add-to-playlist(-1, p);
                                }
                            }
                        }
                    }

                    TextButton {
                        width: parent.width;
                        height: parent.height;
                        text: "Add to playlist  ›";
                        enabled: AppState.selected-count > 0 && AppState.playlists.length > 0;
                        clicked => {
                            add-menu.show({ x: 0px, y: parent.height });
                        }
                    }
                }

                TextButton {
                    text: "Play all";
                    icon: @image-url("icons/play.svg");
                    primary: true;
                    enabled: AppState.rows.length > 0;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.play-all();
                    }
                }
            }
        }

        // Column headings
        Rectangle {
            height: 34px;

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            HeaderText {
                x: Columns.margin;
                y: 0px;
                width: Columns.icon-w;
                height: parent.height;
                text: "#";
            }

            HeaderText {
                x: Columns.margin + Columns.icon-w + Columns.gap;
                y: 0px;
                width: root.title-w;
                height: parent.height;
                text: "TITLE";
            }

            HeaderText {
                x: Columns.margin + Columns.icon-w + Columns.gap + root.title-w + Columns.gap;
                y: 0px;
                width: root.artist-w;
                height: parent.height;
                text: "ARTIST";
            }

            HeaderText {
                x: Columns.margin + Columns.icon-w + Columns.gap + root.title-w + Columns.gap + root.artist-w + Columns.gap;
                y: 0px;
                width: root.album-w;
                height: parent.height;
                text: "ALBUM";
            }

            HeaderText {
                x: parent.width - Columns.margin - Columns.time-w;
                y: 0px;
                width: Columns.time-w;
                height: parent.height;
                text: "TIME";
                horizontal-alignment: right;
            }
        }

        // Rows, or an empty state
        if AppState.rows.length > 0: ListView {
            vertical-stretch: 1;

            for track[index] in AppState.rows: Rectangle {
                height: 42px;

                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Play";
                            activated => {
                                AppState.play-row(index);
                            }
                        }
                        Menu {
                            title: "Add to playlist";
                            enabled: AppState.playlists.length > 0;

                            for playlist[p] in AppState.playlists: MenuItem {
                                title: playlist.name;
                                enabled: p != AppState.view-index;
                                activated => {
                                    AppState.add-to-playlist(index, p);
                                }
                            }
                        }
                        if AppState.view-index >= 0: MenuSeparator {}
                        if AppState.view-index >= 0: MenuItem {
                            title: "Remove from this playlist";
                            activated => {
                                AppState.remove-from-playlist(index);
                            }
                        }
                    }

                    TrackLine {
                        index: index;
                        entry: track;
                        title-w: root.title-w;
                        artist-w: root.artist-w;
                        album-w: root.album-w;
                    }
                }
            }
        }

        if AppState.rows.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: AppState.total-tracks == 0 ? "Your library is empty" : (AppState.view-index >= 0 ? "Nothing here yet" : "No songs match your search");
                    color: Theme.parchment-dim;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: AppState.total-tracks == 0 ? "Use Add folder or Add songs to start listening." : (AppState.view-index >= 0 ? "Select songs in All songs, then use Add to playlist." : "Accents don't matter: slusam finds slušam.");
                    color: Theme.parchment-faint;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
