// Rewritten in Rust from Micro Music Room (WPF) 1.0.3. Modified November 24, 2026.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { IconButton } from "widgets.slint";

component SectionLabel inherits Text {
    color: Theme.parchment-faint;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 38px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.walnut-raised : (touch.has-hover ? Theme.walnut-raised.with-alpha(0.55) : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        if root.icon.width > 0: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: root.selected ? Theme.copper-bright : Theme.parchment-faint;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.parchment : Theme.parchment-dim;
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <bool> creating;

    width: 236px;
    background: Theme.walnut;

    // A hairline between the sidebar and the content
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 18px;
        spacing: 2px;

        // Brand
        HorizontalLayout {
            spacing: 12px;
            padding-bottom: 22px;

            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: Theme.copper;

                Image {
                    source: @image-url("icons/note.svg");
                    width: 22px;
                    height: 22px;
                    colorize: Theme.walnut-deep;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: "micro music room";
                    color: Theme.parchment;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: "YOUR MUSIC, YOUR WAY";
                    color: Theme.brass;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 0.8px;
                }
            }
        }

        SectionLabel {
            text: "YOUR LIBRARY";
            height: 24px;
            vertical-alignment: center;
        }

        NavItem {
            label: "All songs";
            icon: @image-url("icons/library.svg");
            selected: AppState.view-index == -1;
            clicked => {
                AppState.select-view(-1);
            }
        }

        NavItem {
            label: "Recently added";
            icon: @image-url("icons/recent.svg");
            selected: AppState.view-index == -2;
            clicked => {
                AppState.select-view(-2);
            }
        }

        // Playlists header with the "new" button
        HorizontalLayout {
            padding-top: 18px;
            alignment: space-between;

            SectionLabel {
                text: "PLAYLISTS";
                vertical-alignment: center;
            }

            IconButton {
                icon: @image-url("icons/plus.svg");
                glyph: 14px;
                width: 26px;
                height: 26px;
                clicked => {
                    root.creating = true;
                }
            }
        }

        if root.creating: Rectangle {
            height: 38px;
            border-radius: Theme.radius;
            background: Theme.walnut-deep;
            border-width: 1px;
            border-color: Theme.copper;

            FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.creating = false;
                        return accept;
                    }
                    return reject;
                }

                name-input := TextInput {
                    x: 12px;
                    y: 0px;
                    width: parent.width - 24px;
                    height: parent.height;
                    color: Theme.parchment;
                    selection-background-color: Theme.copper;
                    selection-foreground-color: Theme.walnut-deep;
                    font-size: 14px;
                    vertical-alignment: center;
                    init => {
                        self.focus();
                    }
                    accepted => {
                        AppState.create-playlist(self.text);
                        root.creating = false;
                    }
                }
            }

            Text {
                x: 12px;
                y: 0px;
                height: parent.height;
                text: "Playlist name, then Enter";
                color: Theme.parchment-faint;
                font-size: 13px;
                vertical-alignment: center;
                visible: name-input.text == "";
            }
        }

        // The playlists; right-click one to delete it.
        ListView {
            vertical-stretch: 1;

            for playlist[index] in AppState.playlists: Rectangle {
                height: 38px;

                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Delete playlist";
                            activated => {
                                AppState.delete-playlist(index);
                            }
                        }
                    }

                    NavItem {
                        label: playlist.name;
                        selected: AppState.view-index == index;
                        clicked => {
                            AppState.select-view(index);
                        }
                    }
                }
            }
        }

        // About, and the promise
        Rectangle {
            height: 40px;

            Text {
                text: "About & License";
                color: about-touch.has-hover ? Theme.parchment : Theme.parchment-dim;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            about-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    AppState.about-open = true;
                }
            }
        }

        Rectangle {
            height: 88px;
            border-radius: Theme.radius;
            background: Theme.walnut-deep.with-alpha(0.55);
            border-width: 1px;
            border-color: Theme.olive-dim;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: center;

                Text {
                    text: "Your music stays yours";
                    color: Theme.olive;
                    font-size: 12px;
                    font-weight: 700;
                }

                Text {
                    text: "Playlists are saved on this PC. Your audio files stay in their original folders.";
                    color: Theme.parchment-faint;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
