// Rewritten in Rust from Micro Music Room (WPF) 1.0.3. Modified November 24, 2026.

// "Rustic listening room": walnut surfaces, parchment text, copper and brass accents, olive secondary.
global Palette {
    out property <color> walnut-deep: #1c130e;
    out property <color> walnut: #2a1d15;
    out property <color> walnut-raised: #38281d;
    out property <color> border: #4a3626;
    out property <color> parchment: #efe3cc;
    out property <color> parchment-dim: #b9a98c;
    out property <color> copper: #c8743c;
    out property <color> brass: #b89b57;
    out property <color> olive: #7d8250;
}

export component MainWindow inherits Window {
    title: "Micro Music Room";
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1100px;
    preferred-height: 680px;
    background: Palette.walnut-deep;

    // Placeholder shell: sidebar, track area and the persistent bottom player come next.
    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Palette.walnut;
            Text {
                text: "Library";
                color: Palette.brass;
                font-size: 14px;
            }
        }
        Rectangle {
            Text {
                text: "Micro Music Room";
                color: Palette.parchment;
                font-size: 22px;
            }
        }
    }
}
