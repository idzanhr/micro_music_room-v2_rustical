import { Theme } from "theme.slint";

// A round icon button. `prominent` fills it parchment with a dark glyph (the play button);
// `active` tints a toggle that is switched on (shuffle, repeat).
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> glyph: 18px;
    in property <bool> active;
    in property <bool> prominent;
    in property <bool> square;
    in property <bool> enabled: true;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: root.square ? 10px : self.width / 2;
    background: root.prominent ? (touch.has-hover ? #fff6e4 : Theme.parchment) : (touch.has-hover && root.enabled ? Theme.walnut-raised : transparent);
    animate background { duration: 120ms; }

    Image {
        source: root.icon;
        width: root.glyph;
        height: root.glyph;
        colorize: root.prominent ? Theme.walnut-deep : (root.active ? Theme.copper-bright : Theme.parchment);
        opacity: root.enabled ? 1.0 : 0.35;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A text button. `primary` is copper; otherwise it is a quiet raised timber button.
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: label.preferred-width + 36px + (root.icon.width > 0 ? 24px : 0px);
    border-radius: Theme.radius;
    background: root.primary ? (touch.has-hover && root.enabled ? Theme.copper-bright : Theme.copper) : (touch.has-hover && root.enabled ? #46331f : Theme.walnut-raised);
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 120ms; }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 16px;
        padding-right: 16px;

        if root.icon.width > 0: Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.primary ? Theme.walnut-deep : Theme.parchment;
        }

        label := Text {
            text: root.text;
            color: root.primary ? Theme.walnut-deep : Theme.parchment;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A horizontal slider for the seek bar and volume: copper fill on a timber track.
export component Slider inherits Rectangle {
    in-out property <float> value; // 0.0 to 1.0
    in property <bool> enabled: true;
    callback changed(float);

    height: 18px;
    min-width: 40px;

    // Track and fill
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * Math.clamp(root.value, 0.0, 1.0);
            height: parent.height;
            border-radius: 2px;
            background: root.enabled ? Theme.copper : Theme.parchment-faint;
        }
    }

    // Thumb, shown while hovering or dragging
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.parchment;
        x: root.width * Math.clamp(root.value, 0.0, 1.0) - self.width / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled && (touch.has-hover || touch.pressed) ? 1.0 : 0.0;
        animate opacity { duration: 120ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.value = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
    }
}
