import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { IconButton, Slider } from "widgets.slint";

// The persistent bar under the song list: now playing, transport controls with a seek bar, volume.
export component PlayerBar inherits Rectangle {
    height: 96px;
    background: Theme.walnut;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 28px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;

        // Now playing: an art tile, then the title and artist
        HorizontalLayout {
            width: 28%;
            spacing: 14px;

            Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                background: Theme.walnut-raised;

                Image {
                    source: @image-url("icons/note.svg");
                    width: 26px;
                    height: 26px;
                    colorize: AppState.has-current ? Theme.copper : Theme.parchment-faint;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;

                Text {
                    text: AppState.has-current ? AppState.now-title : "Nothing playing";
                    color: AppState.has-current ? Theme.parchment : Theme.parchment-dim;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: AppState.has-current ? AppState.now-artist : "Pick a song to start listening";
                    color: Theme.parchment-faint;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }

        // Transport and seek bar
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            HorizontalLayout {
                alignment: center;
                spacing: 12px;

                IconButton {
                    icon: @image-url("icons/shuffle.svg");
                    active: AppState.shuffle;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.toggle-shuffle();
                    }
                }

                IconButton {
                    icon: @image-url("icons/prev.svg");
                    enabled: AppState.has-current;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.previous();
                    }
                }

                IconButton {
                    icon: AppState.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                    prominent: true;
                    square: true;
                    width: 44px;
                    height: 44px;
                    glyph: 20px;
                    enabled: AppState.has-current;
                    clicked => {
                        AppState.toggle-play();
                    }
                }

                IconButton {
                    icon: @image-url("icons/next.svg");
                    enabled: AppState.has-current;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.next();
                    }
                }

                IconButton {
                    icon: AppState.repeat-mode == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg");
                    active: AppState.repeat-mode != 0;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.cycle-repeat();
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: AppState.elapsed;
                    color: Theme.parchment-dim;
                    font-family: Theme.mono;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 44px;
                }

                Slider {
                    value <=> AppState.progress;
                    enabled: AppState.has-current;
                    horizontal-stretch: 1;
                    changed(v) => {
                        AppState.seek(v);
                    }
                }

                Text {
                    text: AppState.total;
                    color: Theme.parchment-dim;
                    font-family: Theme.mono;
                    font-size: 12px;
                    vertical-alignment: center;
                    width: 44px;
                }
            }
        }

        // Volume
        HorizontalLayout {
            width: 20%;
            alignment: end;
            spacing: 10px;

            Image {
                source: @image-url("icons/volume.svg");
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                colorize: Theme.parchment-dim;
            }

            Slider {
                value <=> AppState.volume;
                width: 130px;
                y: (parent.height - self.height) / 2;
                changed(v) => {
                    AppState.volume-changed(v);
                }
            }
        }
    }
}
